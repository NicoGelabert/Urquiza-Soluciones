APP_NAME="Urquiza Soluciones"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.urquizasoluciones.es

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.urquizasoluciones.es

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="info@urquizasoluciones.es"
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN2_EMAIL=
ADMIN2_PASSWORD=

LEGAL_CONTACT_EMAIL=info@urquizasoluciones.es
LEGAL_HOLDER="Urquiza Soluciones"

GOOGLE_ANALYTICS_ID=
CLARITY_PROJECT_ID=

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

VITE_APP_NAME="${APP_NAME}"
